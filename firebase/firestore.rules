rules_version = '2';

// Todo dato pertenece a un "espacio" (personal o compartido).
// Solo los miembros del espacio pueden leerlo o escribirlo, y el contenido
// llega ya cifrado desde el celular (cifrado de extremo a extremo).
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function esMiembro(espacioId) {
      return autenticado() &&
        request.auth.uid in get(/databases/$(database)/documents/espacios/$(espacioId)).data.miembros;
    }

    match /usuarios/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    match /espacios/{espacioId} {
      allow create: if autenticado() &&
        request.resource.data.miembros == [request.auth.uid];
      allow read, update: if esMiembro(espacioId);
      allow delete: if false;

      match /{coleccion}/{docId} {
        allow read, write: if esMiembro(espacioId);
      }
    }
  }
}
